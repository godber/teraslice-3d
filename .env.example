# Copy to .env and edit: cp .env.example .env
# Used by docker-compose.yml (development).
TERASLICE_URL=http://host.docker.internal:5678
LOG_LEVEL=INFO

# Optional. Leave commented out when unused (an empty value is not the same as unset).
# GRAFANA_URL=http://grafana.example.com
# CACERT_FILE=/certs/ca.pem   # copy your CA file to ./certs/ca.pem (gitignored); ./certs is mounted at /certs
